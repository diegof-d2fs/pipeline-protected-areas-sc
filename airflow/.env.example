# Airflow
AIRFLOW_IMAGE_NAME=protected-areas-sc-airflow:2.8.4-geo
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Main project PostGIS database
PROJECT_DB_HOST=protected-areas-sc-db-main
PROJECT_DB_PORT=5432
PROJECT_DB_NAME=protected-areas-sc-db-main
PROJECT_DB_USER=project
PROJECT_DB_PASSWORD=project
PROJECT_DB_URL=postgresql://project:project@protected-areas-sc-db-main:5432/protected-areas-sc-db-main

# Mutation PostGIS database
MUTATION_DB_HOST=protected-areas-sc-db-mutation
MUTATION_DB_PORT=5432
MUTATION_DB_NAME=protected-areas-sc-db-mutation
MUTATION_DB_USER=mutation
MUTATION_DB_PASSWORD=mutation
MUTATION_DB_URL=postgresql://mutation:mutation@protected-areas-sc-db-mutation:5432/protected-areas-sc-db-mutation

# Local Medallion
MEDALLION_LOCAL_ROOT=./data
MEDALLION_BRONZE_PATH=./data/bronze
MEDALLION_SILVER_PATH=./data/silver
MEDALLION_GOLD_PATH=./data/gold
MEDALLION_TMP_PATH=./data/tmp

# Raw sources that feed Bronze: the project's own 'raw' zone under airflow/data/
# (gitignored). Drop MapBiomas yearly GeoTIFFs and companions in data/raw/mapbiomas/,
# the IBGE Santa Catarina boundary in data/raw/ibge/. No external drives, no mounts.
MAPBIOMAS_SOURCE_DIR=./data/raw/mapbiomas
SC_BOUNDARY_SOURCE_DIR=./data/raw/ibge
MAPBIOMAS_STATISTICS_SOURCE_PATH=./data/raw/mapbiomas/MAPBIOMAS_BRAZIL-COL.11-BIOME_STATE.xlsx

# MapBiomas dataset coordinates. Defaults for DAG_MAPBIOMAS; each run may override
# via dag_run.conf, e.g. {"year": 1985} for a historical backfill.
MAPBIOMAS_COLLECTION=11
MAPBIOMAS_VERSION=1
MAPBIOMAS_YEAR=2025

# MapBiomas Alerta API V2. Fill credentials only in airflow/.env; never store a token.
MAPBIOMAS_ALERTA_EMAIL=
MAPBIOMAS_ALERTA_PASSWORD=
MAPBIOMAS_ALERTA_API_URL=https://plataforma.alerta.mapbiomas.org/api/v2/graphql
MAPBIOMAS_ALERTA_TIMEOUT_SECONDS=60
MAPBIOMAS_ALERTA_TERRITORY_IDS=18393,18387,18407
MAPBIOMAS_ALERTA_PAGE_SIZE=100
MAPBIOMAS_ALERTA_MAX_ATTEMPTS=4

# NASA FIRMS Area API. Keep the real key only in airflow/.env or a secret backend.
FIRMS_MAP_KEY=
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
FIRMS_REQUEST_BBOX=-53.8371493,-29.3550659,-48.3278753,-25.9557228
FIRMS_DAILY_PRODUCTS=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
FIRMS_BACKFILL_PRODUCTS=VIIRS_SNPP_SP,VIIRS_NOAA20_SP,MODIS_SP
FIRMS_OVERLAP_DAYS=1
FIRMS_BACKFILL_BATCH_SIZE=12
FIRMS_CONNECT_TIMEOUT_SECONDS=10
FIRMS_READ_TIMEOUT_SECONDS=60
FIRMS_MAX_ATTEMPTS=4

# AWS: com os dois buckets definidos, o S3 é a fonte da verdade e o disco local é cache.
# Vazios no desenvolvimento local. Credenciais vêm do perfil da instância (nunca chaves aqui).
AWS_REGION=us-east-1
S3_BRONZE_BUCKET=
S3_LAKE_BUCKET=
# Nó de serviço (GeoServer) que recebe o COG Gold por SSM após cada publicação.
SERVING_INSTANCE_ID=
# DISABLE no local; REQUIRE no RDS.
GEOSERVER_DB_SSL_MODE=DISABLE

# GeoServer: login geoserver_svc (mesma senha de PA_SC_REPORTING_GEOSERVER_DB_PASSWORD na API)
REPORTING_GEOSERVER_DB_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=
